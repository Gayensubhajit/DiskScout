export struct BarSegment {
    ratio: float,
    color: color,
}

export component StorageBar inherits Rectangle {
    in property <float> used-percent: 0.0;
    in property <string> used-text: "";
    in property <string> free-text: "";
    in property <string> total-text: "";
    in property <[BarSegment]> segments: [];

    width: 100%;
    height: 48px;
    background: transparent;

    // Segmented bar
    Rectangle {
        y: 4px;
        width: 100%;
        height: 14px;
        background: #e2e8f0;
        border-radius: 7px;
        clip: true;

        if root.segments.length == 0: Rectangle {
            x: 0;
            width: parent.width * root.used-percent;
            height: 100%;
            background: #2563eb;
            border-radius: 7px;
        }

        if root.segments.length > 0: HorizontalLayout {
            spacing: 1px;
            width: 100%;
            height: 100%;

            for seg in root.segments: Rectangle {
                width: parent.width * seg.ratio;
                height: 100%;
                background: seg.color;
            }

            Rectangle {
                horizontal-stretch: 1;
                background: #e2e8f0;
            }
        }
    }

    // Breakdown legend / label below bar
    HorizontalLayout {
        y: 26px;
        alignment: space-between;

        Text {
            text: root.used-text;
            color: #0f172a;
            font-size: 13px;
            font-weight: 600;
            font-family: "JetBrains Mono";
        }

        Text {
            text: root.free-text;
            color: #64748b;
            font-size: 13px;
            font-weight: 500;
            font-family: "JetBrains Mono";
        }
    }
}
