export struct BarSegment {
    name: string,
    size-text: string,
    percent-text: string,
    ratio: float,
    color: color,
}

export struct LegendItem {
    name: string,
    size-text: string,
    color: color,
}

export component StorageBar inherits Rectangle {
    in property <float> used-percent: 0.0;
    in property <string> used-text: "";
    in property <string> free-text: "";
    in property <string> total-text: "";
    in property <[BarSegment]> segments: [];
    in property <[LegendItem]> legend-items: [];

    width: 100%;
    height: 48px;
    background: transparent;

    VerticalLayout {
        spacing: 9px;
        alignment: start;

        // 1. Thicker horizontal capsule meter (20px) with fully rounded ends
        bar-track := Rectangle {
            width: 100%;
            height: 20px;
            background: #f1f5f9; // Subtle neutral free space background
            border-radius: 10px;
            border-width: 1px;
            border-color: #e2e8f0;
            clip: true;

            // USED portion: stacked category meter
            used-container := Rectangle {
                x: 0;
                y: 0;
                height: 100%;
                width: parent.width * Math.min(Math.max(root.used-percent, 0.0), 1.0);
                clip: true;

                HorizontalLayout {
                    spacing: 1px;
                    padding: 0px;

                    for seg in root.segments: seg-rect := Rectangle {
                        width: Math.max(used-container.width * seg.ratio, 3px);
                        height: 100%;
                        background: seg.color;
                        opacity: seg-touch.has-hover ? 0.85 : 1.0;

                        seg-touch := TouchArea {
                            mouse-cursor: default;
                        }
                    }
                }
            }
        }

        // 2. Compact Legend row & free-space indicator
        HorizontalLayout {
            alignment: space-between;

            // Category legend items with colored bullets
            HorizontalLayout {
                spacing: 14px;
                alignment: start;

                for item in root.legend-items: HorizontalLayout {
                    spacing: 5px;
                    alignment: start;

                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: item.color;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: item.name + " " + item.size-text;
                        color: #475569;
                        font-size: 11px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }
            }

            // Free space number visually aligned with free-space side of the meter
            HorizontalLayout {
                spacing: 4px;
                alignment: end;

                Text {
                    text: root.free-text;
                    color: #64748b;
                    font-size: 11px;
                    font-weight: 600;
                    font-family: "JetBrains Mono";
                    vertical-alignment: center;
                }
            }
        }
    }
}
