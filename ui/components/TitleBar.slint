// DiskScout client-side window titlebar (Ryzora-style application shell).
//
// Hyprland draws no server-side titlebars, so the minimize / maximize /
// close controls live here. They dispatch to the REAL native window
// operations via callbacks handled in Rust (`slint::Window`):
// minimize -> set_minimized(true), maximize/restore -> set_maximized(b),
// close -> hide() (which ends app.run() and runs scanner shutdown).
// Window dragging is best-effort: it drives Window::set_position, which
// Wayland compositors ignore by design (use SUPER+drag / tiling there);
// it works where client positioning is allowed (X11, Windows).
export component TitleBar inherits Rectangle {
    callback minimize-clicked();
    callback maximize-clicked();
    callback close-clicked();
    callback drag-move(length, length);
    callback drag-end();

    in property <bool> maximized: false;

    height: 40px;
    background: #141414;

    // Drag layer: fills the bar BEHIND the buttons (declared first, so
    // buttons stacked later receive their clicks first and never drag).
    // Title text and icon fall through to this layer, so they drag too.
    drag := TouchArea {
        width: 100%;
        height: 100%;

        moved => {
            if (drag.pressed) {
                root.drag-move(drag.mouse-x, drag.mouse-y);
            } else {
                root.drag-end();
            }
        }
        double-clicked => {
            root.maximize-clicked();
        }
    }

    HorizontalLayout {
        spacing: 0;
        padding-left: 12px;

        Image {
            source: @image-url("../icons/hard-drive.svg");
            width: 16px;
            height: 16px;
            colorize: #0078d4;
        }

        Rectangle { width: 8px; }

        Text {
            text: "DiskScout";
            color: #e8e8e8;
            font-size: 13px;
            font-weight: 600;
        }

        Rectangle { horizontal-stretch: 1; }

        // Minimize: horizontal line glyph.
        Rectangle {
            width: 46px;
            height: 100%;

            property <brush> bg: min-touch.has-hover ? #2d2d2d : transparent;
            background: bg;

            Path {
                width: 12px;
                height: 12px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                commands: "M 1 6 L 11 6";
                stroke: #cccccc;
                stroke-width: 1.5px;
                fill: transparent;
            }

            min-touch := TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.minimize-clicked(); }
            }
        }

        // Maximize / restore: hollow square, or overlapping squares.
        Rectangle {
            width: 46px;
            height: 100%;

            property <brush> bg: max-touch.has-hover ? #2d2d2d : transparent;
            background: bg;

            if (!root.maximized): Rectangle {
                width: 9px;
                height: 9px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: transparent;
                border-width: 1.5px;
                border-color: #cccccc;
            }

            if (root.maximized): Rectangle {
                width: 12px;
                height: 12px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                Rectangle {
                    width: 7px;
                    height: 7px;
                    x: parent.width - self.width;
                    y: 0;
                    background: transparent;
                    border-width: 1.5px;
                    border-color: #cccccc;
                }

                Rectangle {
                    width: 7px;
                    height: 7px;
                    x: 0;
                    y: parent.height - self.height;
                    background: bg;
                    border-width: 1.5px;
                    border-color: #cccccc;
                }
            }

            max-touch := TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.maximize-clicked(); }
            }
        }

        // Close: X glyph with destructive hover treatment.
        Rectangle {
            width: 46px;
            height: 100%;

            property <brush> bg: close-touch.has-hover ? #e81123 : transparent;
            background: bg;

            Path {
                width: 12px;
                height: 12px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                commands: "M 1.5 1.5 L 10.5 10.5 M 10.5 1.5 L 1.5 10.5";
                stroke: close-touch.has-hover ? #ffffff : #cccccc;
                stroke-width: 1.5px;
                fill: transparent;
            }

            close-touch := TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.close-clicked(); }
            }
        }
    }

    // Bottom divider separating chrome from application content.
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: #2b2b2b;
    }
}
