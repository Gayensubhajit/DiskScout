// DiskScout client-side window titlebar (Cross-platform custom titlebar).
// Preserves custom native window controls (- □ ×) with premium light theme.
export component TitleBar inherits Rectangle {
    callback minimize-clicked();
    callback maximize-clicked();
    callback close-clicked();
    callback drag-move(length, length);
    callback drag-end();

    in property <bool> maximized: false;

    height: 40px;
    background: #ffffff;

    drag := TouchArea {
        width: 100%;
        height: 100%;

        moved => {
            if (drag.pressed) {
                root.drag-move(drag.mouse-x, drag.mouse-y);
            } else {
                root.drag-end();
            }
        }
        double-clicked => {
            root.maximize-clicked();
        }
    }

    HorizontalLayout {
        spacing: 0;
        padding-left: 16px;

        Text {
            text: "DiskScout";
            color: #0f172a;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Rectangle { horizontal-stretch: 1; }

        // Minimize
        Rectangle {
            width: 46px;
            height: 100%;

            property <brush> bg: min-touch.has-hover ? #f1f5f9 : transparent;
            background: bg;

            Path {
                width: 12px;
                height: 12px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                commands: "M 1 6 L 11 6";
                stroke: #475569;
                stroke-width: 1.5px;
                fill: transparent;
            }

            min-touch := TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.minimize-clicked(); }
            }
        }

        // Maximize / restore
        Rectangle {
            width: 46px;
            height: 100%;

            property <brush> bg: max-touch.has-hover ? #f1f5f9 : transparent;
            background: bg;

            if (!root.maximized): Rectangle {
                width: 9px;
                height: 9px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: transparent;
                border-width: 1.5px;
                border-color: #475569;
            }

            if (root.maximized): Rectangle {
                width: 12px;
                height: 12px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                Rectangle {
                    width: 7px;
                    height: 7px;
                    x: parent.width - self.width;
                    y: 0;
                    background: transparent;
                    border-width: 1.5px;
                    border-color: #475569;
                }

                Rectangle {
                    width: 7px;
                    height: 7px;
                    x: 0;
                    y: parent.height - self.height;
                    background: bg;
                    border-width: 1.5px;
                    border-color: #475569;
                }
            }

            max-touch := TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.maximize-clicked(); }
            }
        }

        // Close
        Rectangle {
            width: 46px;
            height: 100%;

            property <brush> bg: close-touch.has-hover ? #ef4444 : transparent;
            background: bg;

            Path {
                width: 12px;
                height: 12px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                commands: "M 1.5 1.5 L 10.5 10.5 M 10.5 1.5 L 1.5 10.5";
                stroke: close-touch.has-hover ? #ffffff : #475569;
                stroke-width: 1.5px;
                fill: transparent;
            }

            close-touch := TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.close-clicked(); }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: #e2e8f0;
    }
}
