export component CleanupRow inherits Rectangle {
    callback review-clicked();
    in property <image> icon;
    in property <string> title: "";
    in property <string> description: "";
    in property <string> size: "";
    in property <string> status-text: "REVIEW FIRST";
    in property <bool> is-safe: false;
    in property <color> icon-tint: #2563eb;
    in property <color> icon-bg: #eff6ff;

    width: 100%;
    height: 78px;
    background: touch.has-hover ? #f8fafc : #ffffff;
    border-radius: 12px;
    border-width: 1px;
    border-color: touch.has-hover ? #cbd5e1 : #e2e8f0;

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 16px;

        // LEFT: Icon Box (44x44)
        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            background: root.icon-bg;
            y: (parent.height - self.height) / 2;

            Image {
                source: root.icon;
                width: 22px;
                height: 22px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: root.icon-tint;
            }
        }

        // CENTER: Title and description (Stretches full remaining width)
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            alignment: center;

            Text {
                text: root.title;
                color: #0f172a;
                font-size: 15px;
                font-weight: 600;
            }

            Text {
                text: root.description;
                color: #64748b;
                font-size: 13px;
            }
        }

        // RIGHT REGION: Strict aligned columns across all rows

        // 1. Size Column (Fixed 110px width)
        Rectangle {
            width: 110px;
            height: 100%;

            Text {
                text: root.size;
                color: #0f172a;
                font-size: 15px;
                font-weight: 700;
                font-family: "JetBrains Mono";
                horizontal-alignment: right;
                vertical-alignment: center;
                width: 100%;
                y: (parent.height - self.height) / 2;
            }
        }

        // 2. Safety Status Badge Column (Fixed 130px width)
        Rectangle {
            width: 130px;
            height: 100%;

            Rectangle {
                width: 120px;
                height: 26px;
                background: root.is-safe ? #dcfce7 : #fef3c7;
                border-radius: 6px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                Text {
                    text: root.status-text;
                    color: root.is-safe ? #15803d : #b45309;
                    font-size: 11px;
                    font-weight: 700;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        // 3. Review Action Button Column (Fixed 96px width)
        Rectangle {
            width: 96px;
            height: 100%;

            TouchArea {
                width: 96px;
                height: 36px;
                x: 0;
                y: (parent.height - self.height) / 2;
                clicked => { root.review-clicked(); }

                Rectangle {
                    background: parent.has-hover ? #e2e8f0 : #f1f5f9;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: parent.has-hover ? #94a3b8 : #cbd5e1;

                    Text {
                        text: "Review →";
                        color: #0f172a;
                        font-size: 13px;
                        font-weight: 600;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
    }
}
