export component StorageCategory inherits Rectangle {
    callback clicked();
    in property <image> icon;
    in property <string> title: "";
    in property <string> size: "";
    in property <string> subtitle: "";
    in property <string> percent: "";
    in property <color> icon-tint: #2563eb;
    in property <color> icon-bg: #eff6ff;
    in property <bool> hovered: false;

    width: 100%;
    height: 64px;
    background: touch.has-hover ? #f8fafc : #ffffff;
    border-radius: 12px;
    border-width: 1px;
    border-color: #e2e8f0;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;

        // Icon
        Rectangle {
            width: 40px;
            height: 40px;
            background: icon-bg;
            border-radius: 10px;
            y: (parent.height - self.height) / 2;

            Image {
                source: icon;
                width: 20px;
                height: 20px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: icon-tint;
            }
        }

        // Title and description (elides when space is constrained)
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 80px;
            spacing: 2px;
            alignment: center;

            Text {
                text: title;
                color: #0f172a;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: subtitle;
                color: #64748b;
                font-size: 12px;
                overflow: elide;
            }
        }

        // Size and percentage
        VerticalLayout {
            width: 80px;
            spacing: 2px;
            alignment: center;

            Text {
                text: size;
                color: #0f172a;
                font-size: 14px;
                font-weight: 700;
                font-family: "JetBrains Mono";
                horizontal-alignment: right;
            }

            Text {
                text: percent;
                color: #94a3b8;
                font-size: 12px;
                font-weight: 500;
                horizontal-alignment: right;
            }
        }

        // Chevron
        Rectangle {
            width: 16px;
            height: 100%;

            Image {
                source: @image-url("../icons/chevron-right.svg");
                width: 16px;
                height: 16px;
                colorize: #94a3b8;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.clicked();
        }
    }
}
