export component StorageCategory inherits Rectangle {
    callback clicked();
    in property <image> icon;
    in property <string> title: "";
    in property <string> size: "";
    in property <string> subtitle: "";
    in property <string> percent: "";
    in property <color> icon-tint: #2563eb;
    in property <color> icon-bg: #eff6ff;
    in property <bool> hovered: false;

    width: 100%;
    height: 64px;
    background: touch.has-hover ? #f8fafc : #ffffff;
    border-radius: 12px;
    border-width: 1px;
    border-color: #e2e8f0;

    Rectangle {
        x: 14px;
        y: 12px;
        width: 40px;
        height: 40px;
        background: icon-bg;
        border-radius: 10px;

        Image {
            source: icon;
            width: 22px;
            height: 22px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            colorize: icon-tint;
        }
    }

    VerticalLayout {
        x: 68px;
        y: 12px;
        spacing: 3px;

        Text {
            text: title;
            color: #0f172a;
            font-size: 14px;
            font-weight: 600;
        }

        Text {
            text: subtitle;
            color: #64748b;
            font-size: 12px;
        }
    }

    VerticalLayout {
        x: parent.width - 150px;
        y: 12px;
        width: 100px;
        alignment: end;
        spacing: 2px;

        Text {
            text: size;
            color: #0f172a;
            font-size: 14px;
            font-weight: 700;
            font-family: "JetBrains Mono";
            horizontal-alignment: right;
        }

        Text {
            text: percent;
            color: #94a3b8;
            font-size: 12px;
            font-weight: 500;
            horizontal-alignment: right;
        }
    }

    Image {
        x: parent.width - 32px;
        y: (parent.height - 18px) / 2;
        width: 18px;
        height: 18px;
        source: @image-url("../icons/chevron-right.svg");
        colorize: #94a3b8;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.clicked();
        }
    }
}
