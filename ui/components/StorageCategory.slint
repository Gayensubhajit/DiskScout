export component StorageCategory inherits Rectangle {
    callback clicked();
    in property <image> icon;
    in property <string> title: "";
    in property <string> size: "";
    in property <string> subtitle: "";
    in property <bool> hovered: false;

    width: 100%;
    height: 64px;
    background: hovered ? #2a2a2a : #1e1e1e;
    border-radius: 8px;
    border-width: 1px;
    border-color: #333333;

    Rectangle {
        x: 16px;
        y: 12px;
        width: 40px;
        height: 40px;
        background: #2d2d2d;
        border-radius: 8px;
        border-width: 1px;
        border-color: #3d3d3d;

        Image {
            source: icon;
            width: 24px;
            height: 24px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            colorize: #0078d4;
        }
    }

    VerticalLayout {
        x: 72px;
        y: 8px;
        spacing: 2px;

        Text {
            text: title;
            color: #ffffff;
            font-size: 14px;
            font-weight: 600;
        }

        Text {
            text: subtitle;
            color: #888888;
            font-size: 12px;
        }
    }

    Text {
        x: parent.width - self.width - 16px;
        y: (parent.height - self.height) / 2;
        text: size;
        color: #cccccc;
        font-size: 14px;
        font-weight: 500;
        font-family: "JetBrains Mono";
    }

    Image {
        x: parent.width - 44px;
        y: (parent.height - 20px) / 2;
        width: 20px;
        height: 20px;
        source: @image-url("../icons/chevron-right.svg");
        colorize: #666666;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.clicked();
        }
    }
}