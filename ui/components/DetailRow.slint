// Breakdown row for a category detail view (Milestone 5 & 7.2.1).
export component DetailRow inherits Rectangle {
    in property <image> icon;
    in property <color> icon-bg: #eff6ff;
    in property <color> icon-tint: #2563eb;
    in property <string> label;
    in property <string> description;
    in property <string> size;
    in property <string> meta;
    in property <string> global-icon-size: "medium"; // "small" | "medium" | "large"

    callback clicked;

    property <length> box-dim: root.global-icon-size == "small" ? 32px : root.global-icon-size == "large" ? 48px : 40px;
    property <length> icon-dim: root.global-icon-size == "small" ? 16px : root.global-icon-size == "large" ? 24px : 20px;
    height: root.global-icon-size == "small" ? 50px : root.global-icon-size == "large" ? 66px : 56px;

    background: touch.has-hover ? #f8fafc : #ffffff;
    border-radius: 10px;
    border-width: 1px;
    border-color: touch.has-hover ? #cbd5e1 : #e2e8f0;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;

        // Adaptive Icon Box
        Rectangle {
            width: root.box-dim;
            height: root.box-dim;
            border-radius: 8px;
            background: root.icon-bg;
            y: (parent.height - self.height) / 2;

            Image {
                source: root.icon;
                width: root.icon-dim;
                height: root.icon-dim;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: root.icon-tint;
            }
        }

        // Title and description (Stretches full remaining width, elides when tight)
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 80px;
            spacing: 2px;
            alignment: center;

            Text {
                text: root.label;
                color: #0f172a;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: root.description;
                color: #64748b;
                font-size: 11px;
                overflow: elide;
            }
        }

        // Size and file count meta (Right-aligned, fixed width for consistent alignment)
        VerticalLayout {
            min-width: 80px;
            spacing: 2px;
            alignment: center;

            Text {
                text: root.size;
                color: #0f172a;
                font-size: 13px;
                font-weight: 700;
                font-family: "JetBrains Mono";
                horizontal-alignment: right;
            }

            if root.meta != "": Text {
                text: root.meta;
                color: #94a3b8;
                font-size: 11px;
                font-weight: 500;
                horizontal-alignment: right;
            }
        }

        // Chevron
        Rectangle {
            width: 14px;
            height: 100%;

            Image {
                source: @image-url("../icons/chevron-right.svg");
                width: 14px;
                height: 14px;
                colorize: #94a3b8;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}


/// Installed application row in Applications inventory (Milestone 7.2 & 7.2.1).
export component AppInventoryRow inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <color> icon-bg: #eff6ff;
    in property <color> icon-tint: #2563eb;
    in property <string> name;
    in property <string> version;
    in property <string> source; // "Pacman", "Foreign", "Flatpak", "Steam"
    in property <string> size;
    in property <string> description;
    in property <string> global-icon-size: "medium"; // "small" | "medium" | "large"

    callback clicked;

    property <length> icon-dim: root.global-icon-size == "small" ? 24px : root.global-icon-size == "large" ? 40px : 32px;
    property <length> box-dim: root.global-icon-size == "small" ? 36px : root.global-icon-size == "large" ? 52px : 44px;
    height: root.global-icon-size == "small" ? 50px : root.global-icon-size == "large" ? 68px : 58px;

    background: touch.has-hover ? #f8fafc : #ffffff;
    border-radius: 10px;
    border-width: 1px;
    border-color: touch.has-hover ? #cbd5e1 : #e2e8f0;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;

        // Icon Box (Adaptive Size)
        Rectangle {
            width: root.box-dim;
            height: root.box-dim;
            border-radius: 8px;
            background: root.has-icon ? transparent :
                root.source == "Foreign" ? #fffbeb :
                root.source == "Flatpak" ? #faf5ff :
                root.source == "Steam" ? #eef2ff :
                #eff6ff;
            y: (parent.height - self.height) / 2;

            // Real application logo in native colors
            if root.has-icon: Image {
                source: root.icon;
                width: root.icon-dim;
                height: root.icon-dim;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            // Fallback generic icon
            if !root.has-icon: Image {
                source: root.source == "Steam" ? @image-url("../icons/gamepad.svg") : @image-url("../icons/apps.svg");
                width: root.icon-dim * 0.65;
                height: root.icon-dim * 0.65;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: root.source == "Foreign" ? #d97706 :
                    root.source == "Flatpak" ? #9333ea :
                    root.source == "Steam" ? #4f46e5 :
                    #2563eb;
            }
        }

        // Title and description / version
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 80px;
            spacing: 2px;
            alignment: center;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: root.name;
                    color: #0f172a;
                    font-size: 13px;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                }

                // Source Badge
                Rectangle {
                    height: 18px;
                    border-radius: 4px;
                    background: root.source == "Foreign" ? #fef3c7 :
                        root.source == "Flatpak" ? #f3e8ff :
                        root.source == "Steam" ? #e0e7ff :
                        #eff6ff;
                    border-width: 1px;
                    border-color: root.source == "Foreign" ? #fde68a :
                        root.source == "Flatpak" ? #e9d5ff :
                        root.source == "Steam" ? #c7d2fe :
                        #bfdbfe;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: center;

                        Text {
                            text: root.source;
                            color: root.source == "Foreign" ? #b45309 :
                                root.source == "Flatpak" ? #7e22ce :
                                root.source == "Steam" ? #4338ca :
                                #1d4ed8;
                            font-size: 10px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.version != "": Text {
                    text: "·  v" + root.version;
                    color: #94a3b8;
                    font-size: 11px;
                    font-weight: 500;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.description;
                color: #64748b;
                font-size: 11px;
                overflow: elide;
            }
        }

        // Size and label
        VerticalLayout {
            min-width: 90px;
            spacing: 2px;
            alignment: center;

            Text {
                text: root.size;
                color: #0f172a;
                font-size: 13px;
                font-weight: 700;
                font-family: "JetBrains Mono";
                horizontal-alignment: right;
            }

            Text {
                text: "Package size";
                color: #94a3b8;
                font-size: 10px;
                font-weight: 500;
                horizontal-alignment: right;
            }
        }

        // Chevron
        Rectangle {
            width: 14px;
            height: 100%;

            Image {
                source: @image-url("../icons/chevron-right.svg");
                width: 14px;
                height: 14px;
                colorize: #94a3b8;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
