// Read-only breakdown row for a category detail view (Milestone 5).
// Deliberately non-interactive: rows explain storage, they are not
// buttons and must not look clickable.
export component DetailRow inherits Rectangle {
    in property <string> label;
    in property <string> size;
    in property <string> meta;

    height: 56px;
    background: #1e1e1e;
    border-radius: 8px;
    border-width: 1px;
    border-color: #333333;

    Text {
        x: 16px;
        y: 9px;
        text: label;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
    }

    Text {
        x: 16px;
        y: parent.height - self.height - 9px;
        text: meta;
        color: #888888;
        font-size: 12px;
    }

    Text {
        x: parent.width - self.width - 16px;
        y: (parent.height - self.height) / 2;
        text: size;
        color: #cccccc;
        font-size: 14px;
        font-weight: 500;
        font-family: "JetBrains Mono";
    }
}
