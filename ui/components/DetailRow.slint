// Breakdown row for a category detail view (Milestone 5).
export component DetailRow inherits Rectangle {
    in property <string> label;
    in property <string> size;
    in property <string> meta;

    height: 56px;
    background: #ffffff;
    border-radius: 10px;
    border-width: 1px;
    border-color: #e2e8f0;

    Text {
        x: 16px;
        y: 10px;
        text: label;
        color: #0f172a;
        font-size: 14px;
        font-weight: 600;
    }

    Text {
        x: 16px;
        y: parent.height - self.height - 10px;
        text: meta;
        color: #64748b;
        font-size: 12px;
    }

    Text {
        x: parent.width - self.width - 16px;
        y: (parent.height - self.height) / 2;
        text: size;
        color: #0f172a;
        font-size: 14px;
        font-weight: 600;
        font-family: "JetBrains Mono";
    }
}
