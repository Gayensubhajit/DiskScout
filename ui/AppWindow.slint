import { StorageBar } from "components/StorageBar.slint";
import { StorageCategory } from "components/StorageCategory.slint";
import { TitleBar } from "components/TitleBar.slint";

struct CategoryRow {
    name: string,
    size: string,
    subtitle: string,
    icon-name: string,
}

export component AppWindow inherits Window {    title: "DiskScout";
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 900px;
    min-height: 650px;
    // Explicitly unbounded maximum: without this, Slint pins max to min
    // and the window stays fixed-size (non-resizable, non-maximizable).
    max-width: 10000px;
    max-height: 10000px;

    in-out property <string> current-page: "storage";

    // Real storage values, set from Rust at startup (Milestone 2).
    // Category rows are real classification output (Milestone 4), pushed
    // from Rust when the background scan finishes; before that they show
    // "…" placeholders, never mocked numbers.
    in-out property <string> drive-name: "Local Disk";
    in-out property <float> used-percent: 0.22;
    in-out property <string> used-text: "100 GB used";
    in-out property <string> free-text: "341 GB free";
    in-out property <string> available-text: "341 GB";
    in-out property <string> status-text: "Your storage is healthy";
    in-out property <bool> status-ok: true;
    in-out property <bool> titlebar-maximized: false;

    // Scroll geometry, calculated in Rust (sync_geometry) and pushed here.
    // Slint-side ancestor height reads would create circular layout
    // dependencies, so the window size is measured once per resize in
    // Rust and only these plain values flow downward.
    in-out property <length> page-h: 616px;
    in-out property <length> flick-h: 384px;
    in-out property <length> viewport-w: 1052px;

    // Category rows from the M4 classifier. `icon-name` resolves through
    // the literal chain in the row template below (dynamic image URLs are
    // impossible in Slint); the Rust `icon_name()` table is the single
    // mapping and is unit-tested against this chain.
    in-out property <[CategoryRow]> categories: [
        { name: "Applications", size: "…", subtitle: "Installed applications and games", icon-name: "apps" },
        { name: "Documents", size: "…", subtitle: "Documents and files", icon-name: "document" },
        { name: "Videos", size: "…", subtitle: "Videos and movies", icon-name: "video" },
        { name: "Pictures", size: "…", subtitle: "Photos and images", icon-name: "image" },
        { name: "Music", size: "…", subtitle: "Music and audio files", icon-name: "music" },
        { name: "Downloads", size: "…", subtitle: "Downloaded files", icon-name: "download" },
        { name: "Temporary files", size: "…", subtitle: "Cache and temporary data", icon-name: "temp" },
        { name: "Trash", size: "…", subtitle: "Deleted files", icon-name: "trash" },
        { name: "Other", size: "…", subtitle: "Other storage", icon-name: "folder" },
    ];
    // Canvas height for 9 rows (9x64 + 8x10 + 2x8 padding = 672px),
    // driven from Rust alongside the model (row count may change).
    in-out property <length> viewport-h: 672px;

    callback minimize-requested();
    callback maximize-requested();
    callback close-requested();
    callback title-drag-move(length, length);
    callback title-drag-end();

    // TEMPORARY shell-debug introspection (removed before merge).
    out property <length> dbg-scroll-h: cat-flick.height;
    out property <length> dbg-viewport-h: cat-flick.viewport-height;
    out property <length> dbg-list-h: cat-list.height;
    out property <length> dbg-page-h: page.height;

    property <color> bg-primary: #111111;
    property <color> bg-surface: #1a1a1a;
    property <color> bg-elevated: #1e1e1e;
    property <color> text-primary: #ffffff;
    property <color> text-secondary: #aaaaaa;
    property <color> text-muted: #666666;
    property <color> accent: #0078d4;
    property <color> border: #333333;

    background: bg-primary;

    VerticalLayout {
        spacing: 0;

        // Client-side window chrome (Hyprland draws no titlebars).
        // Application content starts below this bar.
        TitleBar {
            maximized: root.titlebar-maximized;
            minimize-clicked => { root.minimize-requested(); }
            maximize-clicked => { root.maximize-requested(); }
            close-clicked => { root.close-requested(); }
            drag-move(x, y) => { root.title-drag-move(x, y); }
            drag-end() => { root.title-drag-end(); }
        }

        // Header bar
        Rectangle {
            width: 100%;
            height: 56px;
            background: bg-surface;
            border-width: 1px;
            border-color: border;

            HorizontalLayout {
                spacing: 16px;
                padding: 16px;

                Text {
                    text: "Storage";
                    color: text-primary;
                    font-size: 20px;
                    font-weight: 600;
                }

                Rectangle { horizontal-stretch: 1; }

                TouchArea {
                    width: 40px;
                    height: 40px;

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: transparent;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: border;

                        Image {
                            source: @image-url("icons/settings.svg");
                            width: 20px;
                            height: 20px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: text-secondary;
                        }
                    }
                }
            }
        }

        // Tab bar
        Rectangle {
            width: 100%;
            height: 48px;
            background: bg-surface;
            border-width: 1px;
            border-color: border;

            HorizontalLayout {
                spacing: 0;
                padding-left: 16px;

                // Storage tab
                TouchArea {
                    width: 120px;
                    height: 100%;
                    clicked => { root.current-page = "storage"; }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: root.current-page == "storage" ? bg-primary : transparent;

                        Text {
                            text: "Storage";
                            color: root.current-page == "storage" ? accent : text-secondary;
                            font-size: 14px;
                            font-weight: 500;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                // Cleanup tab
                TouchArea {
                    width: 120px;
                    height: 100%;
                    clicked => { root.current-page = "cleanup"; }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: root.current-page == "cleanup" ? bg-primary : transparent;

                        Text {
                            text: "Cleanup";
                            color: root.current-page == "cleanup" ? accent : text-secondary;
                            font-size: 14px;
                            font-weight: 500;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }
        }

        // Content area - Storage page. Height arrives from Rust
        // (page-h); see the property comment above.
        page := Rectangle {
            height: root.page-h;
            background: bg-primary;
            visible: root.current-page == "storage";

            VerticalLayout {
                spacing: 0;
                padding: 24px;

                // Drive info card
                Rectangle {
                    width: 100%;
                    height: 144px;
                    background: bg-elevated;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: border;

                    HorizontalLayout {
                        spacing: 24px;
                        padding: 24px;

                        // Drive icon
                        Rectangle {
                            width: 72px;
                            height: 72px;
                            background: #1a1a2e;
                            border-radius: 16px;
                            border-width: 1px;
                            border-color: #2d2d4a;

                            Image {
                                source: @image-url("icons/hard-drive.svg");
                                width: 36px;
                                height: 36px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: accent;
                            }
                        }

                        // Drive info
                        VerticalLayout {
                            spacing: 8px;
                            horizontal-stretch: 1;

                            Text {
                                text: root.drive-name;
                                color: text-primary;
                                font-size: 18px;
                                font-weight: 600;
                            }

                            StorageBar {
                                width: 100%;
                                used-percent: root.used-percent;
                                used-text: root.used-text;
                                free-text: root.free-text;
                            }

                            Text {
                                text: root.status-text;
                                color: root.status-ok ? #4ade80 : #f87171;
                                font-size: 13px;
                                font-weight: 500;
                            }
                        }

                        // Spacer
                        Rectangle { horizontal-stretch: 1; }

                        // Free space big number
                        VerticalLayout {
                            spacing: 4px;

                            Text {
                                text: root.available-text;
                                color: text-primary;
                                font-size: 36px;
                                font-weight: 700;
                                font-family: "JetBrains Mono";
                            }

                            Text {
                                text: "available";
                                color: text-muted;
                                font-size: 13px;
                            }
                        }
                    }
                }

                // Section header
                Rectangle {
                    width: 100%;
                    height: 40px;

                    Text {
                        y: (parent.height - self.height) / 2;
                        text: "Storage usage";
                        color: text-secondary;
                        font-size: 13px;
                        font-weight: 600;
                    }
                }

                // Categories list (scrollable; header/tabs/drive card stay fixed).
                // All scroll inputs arrive from Rust (flick-h/viewport-w/
                // viewport-h) or are model-driven. The canvas height follows
                // the row count; Slint ancestor geometry is never read back,
                // keeping the layoutinfo graph acyclic (M3.5).
                cat-flick := Flickable {
                    height: root.flick-h;
                    width: 100%;
                    viewport-width: root.viewport-w;
                    viewport-height: root.viewport-h;
                    viewport-x: 0px;
                    viewport-y: 0px;

                    cat-list := VerticalLayout {
                        width: root.viewport-w;
                        height: root.viewport-h;
                        spacing: 10px;
                        padding: 8px;

                        for row in root.categories: StorageCategory {
                            icon: row.icon-name == "apps" ? @image-url("icons/apps.svg") :
                                row.icon-name == "document" ? @image-url("icons/document.svg") :
                                row.icon-name == "video" ? @image-url("icons/video.svg") :
                                row.icon-name == "image" ? @image-url("icons/image.svg") :
                                row.icon-name == "music" ? @image-url("icons/music.svg") :
                                row.icon-name == "download" ? @image-url("icons/download.svg") :
                                row.icon-name == "temp" ? @image-url("icons/temp.svg") :
                                row.icon-name == "trash" ? @image-url("icons/trash.svg") :
                                @image-url("icons/folder.svg");
                            title: row.name;
                            size: row.size;
                            subtitle: row.subtitle;
                        }
                    }
                }
            }
        }

        // Content area - Cleanup page (placeholder)
        Rectangle {
            height: root.page-h;
            background: bg-primary;
            visible: root.current-page == "cleanup";

            VerticalLayout {
                spacing: 24px;
                padding: 24px;

                Rectangle {
                    height: 100%;
                    background: bg-elevated;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: border;

                    VerticalLayout {
                        spacing: 16px;
                        padding: 48px;

                        Text {
                            text: "Clean up storage";
                            color: text-primary;
                            font-size: 24px;
                            font-weight: 600;
                        }

                        Text {
                            text: "This feature is coming soon.";
                            color: text-secondary;
                            font-size: 16px;
                        }

                        Text {
                            text: "We'll add safe cleanup for:\n• Temporary files\n• Package cache\n• Trash\n• Unused Flatpak runtimes\n• Btrfs snapshots";
                            color: text-muted;
                            font-size: 14px;
                        }
                    }
                }
            }
        }
    }
}