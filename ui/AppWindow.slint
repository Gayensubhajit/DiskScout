import { StorageBar } from "components/StorageBar.slint";
import { StorageCategory } from "components/StorageCategory.slint";

export component AppWindow inherits Window {
    width: 720px;
    height: 900px;
    title: "Storage Manager";

    in-out property <string> current-page: "storage";

    // Real storage values, set from Rust at startup (Milestone 2).
    // Categories below remain mocked until Milestone 3.
    in-out property <string> drive-name: "Local Disk";
    in-out property <float> used-percent: 0.22;
    in-out property <string> used-text: "100 GB used";
    in-out property <string> free-text: "341 GB free";
    in-out property <string> available-text: "341 GB";
    in-out property <string> status-text: "Your storage is healthy";
    in-out property <bool> status-ok: true;

    property <color> bg-primary: #111111;
    property <color> bg-surface: #1a1a1a;
    property <color> bg-elevated: #1e1e1e;
    property <color> text-primary: #ffffff;
    property <color> text-secondary: #aaaaaa;
    property <color> text-muted: #666666;
    property <color> accent: #0078d4;
    property <color> border: #333333;

    background: bg-primary;

    VerticalLayout {
        spacing: 0;

        // Header bar
        Rectangle {
            width: 100%;
            height: 56px;
            background: bg-surface;
            border-width: 1px;
            border-color: border;

            HorizontalLayout {
                spacing: 16px;
                padding: 16px;

                Text {
                    text: "Storage";
                    color: text-primary;
                    font-size: 20px;
                    font-weight: 600;
                }

                Rectangle { horizontal-stretch: 1; }

                TouchArea {
                    width: 40px;
                    height: 40px;

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: transparent;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: border;

                        Image {
                            source: @image-url("icons/settings.svg");
                            width: 20px;
                            height: 20px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: text-secondary;
                        }
                    }
                }
            }
        }

        // Tab bar
        Rectangle {
            width: 100%;
            height: 48px;
            background: bg-surface;
            border-width: 1px;
            border-color: border;

            HorizontalLayout {
                spacing: 0;
                padding-left: 16px;

                // Storage tab
                TouchArea {
                    width: 120px;
                    height: 100%;
                    clicked => { root.current-page = "storage"; }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: root.current-page == "storage" ? bg-primary : transparent;

                        Text {
                            text: "Storage";
                            color: root.current-page == "storage" ? accent : text-secondary;
                            font-size: 14px;
                            font-weight: 500;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                // Cleanup tab
                TouchArea {
                    width: 120px;
                    height: 100%;
                    clicked => { root.current-page = "cleanup"; }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: root.current-page == "cleanup" ? bg-primary : transparent;

                        Text {
                            text: "Cleanup";
                            color: root.current-page == "cleanup" ? accent : text-secondary;
                            font-size: 14px;
                            font-weight: 500;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }
        }

        // Content area - Storage page
        Rectangle {
            width: 100%;
            height: 100%;
            background: bg-primary;
            visible: root.current-page == "storage";

            VerticalLayout {
                spacing: 0;
                padding: 24px;

                // Drive info card
                Rectangle {
                    width: 100%;
                    height: 144px;
                    background: bg-elevated;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: border;

                    HorizontalLayout {
                        spacing: 24px;
                        padding: 24px;

                        // Drive icon
                        Rectangle {
                            width: 72px;
                            height: 72px;
                            background: #1a1a2e;
                            border-radius: 16px;
                            border-width: 1px;
                            border-color: #2d2d4a;

                            Image {
                                source: @image-url("icons/hard-drive.svg");
                                width: 36px;
                                height: 36px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: accent;
                            }
                        }

                        // Drive info
                        VerticalLayout {
                            spacing: 8px;

                            Text {
                                text: root.drive-name;
                                color: text-primary;
                                font-size: 18px;
                                font-weight: 600;
                            }

                            StorageBar {
                                width: 300px;
                                used-percent: root.used-percent;
                                used-text: root.used-text;
                                free-text: root.free-text;
                            }

                            Text {
                                text: root.status-text;
                                color: root.status-ok ? #4ade80 : #f87171;
                                font-size: 13px;
                                font-weight: 500;
                            }
                        }

                        // Spacer
                        Rectangle { horizontal-stretch: 1; }

                        // Free space big number
                        VerticalLayout {
                            spacing: 4px;

                            Text {
                                text: root.available-text;
                                color: text-primary;
                                font-size: 36px;
                                font-weight: 700;
                                font-family: "JetBrains Mono";
                            }

                            Text {
                                text: "available";
                                color: text-muted;
                                font-size: 13px;
                            }
                        }
                    }
                }

                // Section header
                Rectangle {
                    width: 100%;
                    height: 40px;

                    Text {
                        y: (parent.height - self.height) / 2;
                        text: "Storage usage";
                        color: text-secondary;
                        font-size: 13px;
                        font-weight: 600;
                    }
                }

                // Categories list
                VerticalLayout {
                    spacing: 10px;
                    padding: 8px;

                    StorageCategory {
                        icon: @image-url("icons/apps.svg");
                        title: "Applications";
                        size: "18.4 GB";
                        subtitle: "Installed applications and games";
                    }

                    StorageCategory {
                        icon: @image-url("icons/document.svg");
                        title: "Documents";
                        size: "8.7 GB";
                        subtitle: "Documents and files";
                    }

                    StorageCategory {
                        icon: @image-url("icons/video.svg");
                        title: "Videos";
                        size: "5.6 GB";
                        subtitle: "Videos and movies";
                    }

                    StorageCategory {
                        icon: @image-url("icons/image.svg");
                        title: "Pictures";
                        size: "2.3 GB";
                        subtitle: "Photos and images";
                    }

                    StorageCategory {
                        icon: @image-url("icons/music.svg");
                        title: "Music";
                        size: "216 MB";
                        subtitle: "Music and audio files";
                    }

                    StorageCategory {
                        icon: @image-url("icons/temp.svg");
                        title: "Temporary files";
                        size: "9.1 GB";
                        subtitle: "Cache and temporary data";
                    }

                    StorageCategory {
                        icon: @image-url("icons/trash.svg");
                        title: "Trash";
                        size: "1.4 GB";
                        subtitle: "Deleted files";
                    }

                    StorageCategory {
                        icon: @image-url("icons/folder.svg");
                        title: "Other";
                        size: "31.2 GB";
                        subtitle: "Other storage";
                    }
                }
            }
        }

        // Content area - Cleanup page (placeholder)
        Rectangle {
            width: 100%;
            height: 100%;
            background: bg-primary;
            visible: root.current-page == "cleanup";

            VerticalLayout {
                spacing: 24px;
                padding: 24px;

                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: bg-elevated;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: border;

                    VerticalLayout {
                        spacing: 16px;
                        padding: 48px;

                        Text {
                            text: "Clean up storage";
                            color: text-primary;
                            font-size: 24px;
                            font-weight: 600;
                        }

                        Text {
                            text: "This feature is coming soon.";
                            color: text-secondary;
                            font-size: 16px;
                        }

                        Text {
                            text: "We'll add safe cleanup for:\n• Temporary files\n• Package cache\n• Trash\n• Unused Flatpak runtimes\n• Btrfs snapshots";
                            color: text-muted;
                            font-size: 14px;
                        }
                    }
                }
            }
        }
    }
}